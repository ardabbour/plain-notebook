{
  "name": "plain-notebook",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A small, multilingual personal website built from Markdown.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "node src/build.js",
    "preview": "node src/server.js --preview",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "node src/check.js",
    "deploy": "npm run check && npx --yes wrangler@4.132.0 deploy",
    "test:deployment": "node scripts/smoke-deployment.js"
  },
  "dependencies": {
    "@mdit/plugin-tex": "1.1.1",
    "beautiful-mermaid": "1.1.3",
    "cheerio": "1.2.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "katex": "0.18.7",
    "markdown-it": "^15.0.2",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
